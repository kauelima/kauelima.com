---
import { render } from 'astro:content';
import CaseStudy from '@/layouts/CaseStudy.astro';
import OnlyIn from '@/components/OnlyIn.astro';
import { getProjectsFor } from '@/lib/projects';

export async function getStaticPaths() {
  const projects = await getProjectsFor('design');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<CaseStudy project={project} discipline="design">
  <Content components={{ OnlyIn }} />
</CaseStudy>
