---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import portrait from '@/assets/portrait.webp';

const facts = [
  ['Based', 'Campinas, Brazil'],
  ['Working', 'Remote'],
  ['Experience', '14+ years'],
  ['Focus', 'Design & Product'],
];
---

<Base
  title="About"
  description="Kaue Lima — Product Specialist based in Campinas, Brazil. Fourteen years across design and product.">
  <PageHeader
    eyebrow="About"
    title="A problem solver, working where design and product overlap."
  />

  <div class="wrap grid gap-12 md:grid-cols-[1fr_20rem] md:gap-16">
    <div class="prose-about">
      <p>
        I'm Kaue Lima, a Product Specialist with more than fourteen years of
        experience. I started in design and moved into product without ever
        really leaving design behind — the two disciplines inform each other
        constantly, and the projects I'm proudest of are the ones where I got to
        do both.
      </p>
      <p>
        Most of my work has been in operationally complex domains: field sales,
        delivery logistics, restaurant kitchens, payments. These are environments
        where the user is busy, distracted, and often standing up. That teaches a
        particular kind of discipline — the interface has to be right the first
        time, because nobody is going to explore it.
      </p>
      <p>
        More recently I've been working on consumer software, where the same
        principle applies for different reasons: people don't read, they scan,
        and a product earns its place by removing work rather than adding
        features.
      </p>

      {/* TODO(kaue): this section is a starting point drawn from your current
          site and CV. Rewrite it in your own voice — it's the page people read
          before deciding whether to email you. */}

      <h2>How I work</h2>
      <p>
        I care about the decision, not the deliverable. A tidy spec that
        describes the wrong thing is worse than a rough sketch that describes the
        right one. Most of my value shows up early — in framing the problem
        properly — and late, in the unglamorous work of making sure what shipped
        matches what was intended.
      </p>
    </div>

    <aside>
      <Image
        src={portrait}
        alt="Kaue Lima"
        width={480}
        height={480}
        class="w-full max-w-xs border border-rule md:max-w-none"
        loading="eager"
      />
      <dl class="mt-8 border-t border-rule">
        {facts.map(([k, v]) => (
          <div class="flex justify-between gap-4 border-b border-rule py-3">
            <dt class="text-sm font-bold uppercase tracking-[0.16em] text-mute">{k}</dt>
            <dd class="text-sm font-medium">{v}</dd>
          </div>
        ))}
      </dl>
    </aside>
  </div>
</Base>

<style>
  .prose-about { max-width: 44rem; }
  .prose-about > * + * { margin-top: 1.25rem; }
  .prose-about p { font-size: 1.0625rem; line-height: 1.65; }
  .prose-about h2 {
    font-size: var(--text-title);
    font-weight: 800;
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-rule);
  }
</style>
