---
const year = new Date().getFullYear();
const links = [
  { href: 'mailto:kaue@kauelima.com', label: 'kaue@kauelima.com' },
  { href: 'https://www.linkedin.com/in/kauelima', label: 'LinkedIn' },
];
---

<footer class="mt-[var(--spacing-section)] border-t border-rule">
  <div class="wrap grid gap-10 py-14 sm:grid-cols-2">
    <div>
      <p class="font-display text-title font-extrabold">Let's talk.</p>
      <p class="mt-3 max-w-sm text-mute">
        Open to product and design work. Based in Campinas, Brazil — working remote.
      </p>
    </div>

    <ul class="flex flex-col gap-1 sm:items-end">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="inline-flex min-h-11 items-center font-medium decoration-yellow decoration-4 underline-offset-4 hover:underline">
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="wrap flex flex-col gap-1 border-t border-rule py-6 text-sm text-mute sm:flex-row sm:justify-between">
    <p>&copy; {year} Kaue Lima</p>
    <p>Built with Astro</p>
  </div>
</footer>
