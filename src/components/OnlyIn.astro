---
/**
 * Scopes a passage of a shared case study to one discipline.
 *
 * The current discipline is read from the URL rather than plumbed through as a
 * prop, because this renders inside MDX where currying a component isn't
 * possible — /design/<slug> and /product/<slug> are the only routes that use it.
 */
interface Props {
  discipline: 'design' | 'product';
}
const { discipline } = Astro.props;
const current = Astro.url.pathname.split('/').filter(Boolean)[0];
---

{current === discipline && <slot />}
