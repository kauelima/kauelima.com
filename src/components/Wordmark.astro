---
/**
 * Decorative KAUELIMA wordmark, anchored top-left and cropped off the right.
 *
 * Three details keep this robust:
 *
 * 1. `textLength` + `lengthAdjust` force the word to exactly fill the viewBox
 *    width whatever font resolves, so the crop is identical before and after
 *    Archivo lands — no reflow on webfont swap.
 * 2. `preserveAspectRatio="xMinYMin slice"` scales to *cover* and pins the
 *    top-left corner, so the K is always fully visible and every letter is
 *    lost from the right edge instead of both.
 * 3. The viewBox and the text origin are trimmed to the *painted* ink box —
 *    measured from rendered pixels, not font metrics, since getBBox() reports
 *    the line box. That removes the ascender gap above the caps and the K's
 *    left side bearing, so the block sits genuinely flush to the header and
 *    the left edge.
 *
 * Crop depth is just the box height: taller box, deeper crop.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['wordmark', className]} aria-hidden="true">
  <svg viewBox="0 0 1000 139.6" preserveAspectRatio="xMinYMin slice" role="presentation">
    <text
      x="-13.3"
      y="137.5"
      textLength="1000"
      lengthAdjust="spacingAndGlyphs">KAUELIMA</text>
  </svg>
</div>
<span class="sr-only">Kaue Lima</span>

<style>
  .wordmark {
    width: 100%;
    height: 24vw;
    overflow: hidden;
  }

  .wordmark svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .wordmark text {
    font-family: var(--font-archivo), ui-sans-serif, system-ui, sans-serif;
    font-weight: 900;
    font-size: 200px;
    letter-spacing: -0.045em;
    fill: var(--color-ink);
  }

  /* Bigger and more cropped as the viewport widens. */
  @media (min-width: 640px)  { .wordmark { height: 28vw; } }
  @media (min-width: 768px)  { .wordmark { height: 30vw; } }
  @media (min-width: 1024px) { .wordmark { height: 32vw; } }
  @media (min-width: 1280px) { .wordmark { height: 34vw; max-height: 70vh; } }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border-width: 0;
  }
</style>
